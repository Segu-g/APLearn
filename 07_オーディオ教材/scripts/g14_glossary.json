  },
  {
   "speaker": "metan",
   "text": "CC。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Creative Commons。"
  },
  {
   "speaker": "zundamon",
   "text": "著作物の利用条件を示すライセンス"
  },
  {
   "speaker": "metan",
   "text": "CC（評価基準）。",
   "yomi": "シーシー。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Common Criteria。"
  },
  {
   "speaker": "zundamon",
   "text": "ISO/IEC 15408。IT製品のセキュリティ評価基準",
   "yomi": "ISO、IEC 15408。IT製品のセキュリティ評価基準"
  },
  {
   "speaker": "metan",
   "text": "PPP / PFI。",
   "yomi": "ピーピーピー、ピーエフアイ。"
  },
  {
   "pause": 1.5
  },
  {
