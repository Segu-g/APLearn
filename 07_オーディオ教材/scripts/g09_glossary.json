  {
   "speaker": "metan",
   "text": "CMDB。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Configuration Management DataBase。"
  },
  {
   "speaker": "zundamon",
   "text": "構成管理データベース。構成品目の情報を管理"
  },
  {
   "speaker": "metan",
   "text": "CI。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Configuration Item。"
  },
  {
   "speaker": "zundamon",
   "text": "構成品目。管理対象のハード・ソフト・文書など（開発のCIとは別）",
