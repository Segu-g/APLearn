  {
   "speaker": "metan",
   "text": "RTO。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Recovery Time Objective。"
  },
  {
   "speaker": "zundamon",
   "text": "目標復旧時間。何時間以内に復旧するか"
