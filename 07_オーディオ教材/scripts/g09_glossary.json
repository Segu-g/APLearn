  {
   "speaker": "metan",
   "text": "FAQ。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Frequently Asked Questions。"
  },
  {
   "speaker": "zundamon",
   "text": "よくある質問と回答"
  },
  {
   "speaker": "metan",
   "text": "UPS。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Uninterruptible Power Supply。"
  },
  {
   "speaker": "zundamon",
   "text": "無停電電源装置"
  },
