  },
  {
   "speaker": "zundamon",
   "text": "サービスレベル管理"
  },
  {
   "speaker": "metan",
   "text": "SLO。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Service Level Objective。"
  },
  {
   "speaker": "zundamon",
   "text": "サービスレベル目標（SLAの個々の目標値）",
