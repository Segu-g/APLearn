   "text": "Known Error DataBase。"
  },
  {
   "speaker": "zundamon",
   "text": "既知の誤り（根本原因と回避策）のデータベース",
   "yomi": "既知の誤り、根本原因と回避策、のデータベース"
  },
  {
   "speaker": "metan",
   "text": "BCP。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Business Continuity Plan。"
  },
  {
   "speaker": "zundamon",
   "text": "事業継続計画。災害等で業務を継続・早期復旧する計画"
  },
  {
   "speaker": "metan",
   "text": "BCM。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Business Continuity Management。"
  },
  {
   "speaker": "zundamon",
   "text": "事業継続マネジメント"
  },
  {
   "speaker": "metan",
   "text": "DR。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Disaster Recovery。"
  },
  {
   "speaker": "zundamon",
   "text": "災害復旧"
  },
  {
   "speaker": "metan",
   "text": "RPO。"
  },
  {
   "pause": 1.5
  },
  {
   "speaker": "zundamon",
   "text": "Recovery Point Objective。"
  },
  {
   "speaker": "zundamon",
   "text": "目標復旧時点。どの時点のデータまで戻すか"
